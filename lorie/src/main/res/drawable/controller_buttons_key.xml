<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_hovered="true">
        <shape>
            <solid android:color="@color/controller_buttons_accent_tint" />
            <stroke android:width="3dp" android:color="@color/controller_buttons_accent_text" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true" android:state_focused="true">
        <shape>
            <solid android:color="@color/controller_buttons_accent_tint" />
            <stroke android:width="3dp" android:color="@color/controller_buttons_accent_text" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/controller_buttons_accent_tint" />
            <stroke android:width="2dp" android:color="@color/controller_buttons_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="@color/controller_buttons_surface_2" />
            <stroke android:width="3dp" android:color="@color/controller_buttons_accent_text" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/controller_buttons_surface_2" />
            <stroke android:width="3dp" android:color="@color/controller_buttons_accent_text" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/controller_buttons_surface_2" />
            <stroke android:width="2dp" android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
