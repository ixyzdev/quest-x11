<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_hovered="true">
        <shape>
            <stroke android:width="3dp" android:color="@color/controller_buttons_accent_text" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <stroke android:width="3dp" android:color="@color/controller_buttons_accent_text" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="2dp" android:color="@color/controller_buttons_fixed" android:dashWidth="8dp" android:dashGap="6dp" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
