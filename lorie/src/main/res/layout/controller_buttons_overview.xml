<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/controller_buttons_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/ControllerButtons.Header">

            <ImageView
                android:id="@+id/controller_buttons_close"
                style="@style/ControllerButtons.BackButton" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/ControllerButtons.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lorie_pref_controllerButtons" />

                <TextView
                    style="@style/ControllerButtons.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/lorie_pref_controllerButtons_summary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/controller_buttons_segments"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    style="@style/ControllerButtons.Pill"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/controller_buttons_segment_active"
                    android:drawableStart="@drawable/controller_buttons_dot_running"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/controller_buttons_mode_2d"
                    android:textColor="@color/controller_buttons_bg" />

                <TextView
                    android:id="@+id/controller_buttons_immersive"
                    style="@style/ControllerButtons.Pill.Unavailable"
                    android:background="@drawable/controller_buttons_pill_quiet"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/controller_buttons_mode_immersive" />
            </LinearLayout>

            <TextView
                android:id="@+id/controller_buttons_presets"
                style="@style/ControllerButtons.Pill.Unavailable"
                android:layout_marginStart="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/controller_buttons_presets" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <LinearLayout
                style="@style/ControllerButtons.Panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/controller_buttons_info_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:importantForAccessibility="no"
                        android:tint="@color/controller_buttons_accent_text" />

                    <TextView
                        android:id="@+id/controller_buttons_info"
                        style="@style/ControllerButtons.Text.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/controller_buttons_left_drawing"
                            layout="@layout/controller_buttons_left" />

                        <TextView
                            style="@style/ControllerButtons.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/controller_buttons_left" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/controller_buttons_left_trigger"
                                style="@style/ControllerButtons.Locked"
                                android:layout_marginEnd="8dp"
                                android:text="@string/controller_buttons_trigger" />

                            <TextView
                                android:id="@+id/controller_buttons_left_grip"
                                style="@style/ControllerButtons.Locked"
                                android:text="@string/controller_buttons_grip" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="48dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/controller_buttons_right_drawing"
                            layout="@layout/controller_buttons_right" />

                        <TextView
                            style="@style/ControllerButtons.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/controller_buttons_right" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/controller_buttons_right_trigger"
                                style="@style/ControllerButtons.Locked"
                                android:layout_marginEnd="8dp"
                                android:text="@string/controller_buttons_trigger" />

                            <TextView
                                android:id="@+id/controller_buttons_right_grip"
                                style="@style/ControllerButtons.Locked"
                                android:text="@string/controller_buttons_grip" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/controller_buttons_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ControllerButtons.Legend"
                        android:drawableStart="@drawable/controller_buttons_legend_mapped"
                        android:text="@string/controller_buttons_legend_mapped" />

                    <TextView
                        style="@style/ControllerButtons.Legend"
                        android:drawableStart="@drawable/controller_buttons_legend_default"
                        android:text="@string/controller_buttons_legend_default" />

                    <TextView
                        android:id="@+id/controller_buttons_legend_shared"
                        style="@style/ControllerButtons.Legend"
                        android:text="@string/controller_buttons_legend_shared" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ControllerButtons.Legend"
                        android:drawableStart="@drawable/controller_buttons_legend_fixed"
                        android:text="@string/controller_buttons_legend_fixed" />

                    <TextView
                        style="@style/ControllerButtons.Legend"
                        android:drawableStart="@drawable/controller_buttons_legend_system"
                        android:text="@string/controller_buttons_legend_system" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/ControllerButtons.Panel"
                android:layout_width="452dp"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ControllerButtons.Text.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/controller_buttons_mappable" />

                    <TextView
                        android:id="@+id/controller_buttons_input_count"
                        style="@style/ControllerButtons.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controller_buttons_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <TextView
                android:id="@+id/controller_buttons_test"
                style="@style/ControllerButtons.Pill"
                android:layout_marginEnd="16dp"
                android:text="@string/controller_buttons_test" />

            <TextView
                android:id="@+id/controller_buttons_diagnostics"
                style="@style/ControllerButtons.Pill.Dashed" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/controller_buttons_reset"
                style="@style/ControllerButtons.Pill.Quiet"
                android:text="@string/controller_buttons_reset" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
