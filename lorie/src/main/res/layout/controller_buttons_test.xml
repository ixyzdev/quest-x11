<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/controller_buttons_bg"
    android:orientation="vertical">

    <LinearLayout style="@style/ControllerButtons.Header">

        <ImageView
            android:id="@+id/controller_buttons_close"
            style="@style/ControllerButtons.BackButton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/ControllerButtons.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/controller_buttons_test" />

            <TextView
                style="@style/ControllerButtons.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/controller_buttons_test_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="48dp">

            <LinearLayout
                android:layout_width="760dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/controller_buttons_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="40dp">

                <LinearLayout
                    android:id="@+id/controller_buttons_waiting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="160dp">

                        <ProgressBar
                            android:id="@+id/controller_buttons_countdown"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="10000"
                            android:maxWidth="160dp"
                            android:maxHeight="160dp"
                            android:minWidth="160dp"
                            android:minHeight="160dp"
                            android:progressDrawable="@drawable/controller_buttons_countdown" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/controller_buttons_seconds"
                                style="@style/ControllerButtons.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textSize="48sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/ControllerButtons.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/controller_buttons_seconds" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        style="@style/ControllerButtons.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:text="@string/controller_buttons_press_now" />

                    <TextView
                        style="@style/ControllerButtons.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/controller_buttons_press_hint"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/controller_buttons_cancel"
                        style="@style/ControllerButtons.Pill.Outlined"
                        android:layout_marginTop="24dp"
                        android:text="@string/controller_buttons_cancel" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controller_buttons_received"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/controller_buttons_received"
                        android:importantForAccessibility="no"
                        android:padding="32dp"
                        android:src="@drawable/ic_controller_check"
                        android:tint="@color/controller_buttons_accent_text" />

                    <TextView
                        android:id="@+id/controller_buttons_received_title"
                        style="@style/ControllerButtons.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/controller_buttons_received_message"
                        style="@style/ControllerButtons.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/controller_buttons_test_another"
                            style="@style/ControllerButtons.Pill.Outlined"
                            android:text="@string/controller_buttons_test_another" />

                        <TextView
                            android:id="@+id/controller_buttons_change_action"
                            style="@style/ControllerButtons.Pill.Primary"
                            android:layout_marginStart="16dp"
                            android:text="@string/controller_buttons_change_action" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controller_buttons_nothing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/controller_buttons_nothing"
                        android:importantForAccessibility="no"
                        android:padding="36dp"
                        android:src="@drawable/ic_controller_dash"
                        android:tint="@color/controller_buttons_text_3" />

                    <TextView
                        style="@style/ControllerButtons.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:text="@string/controller_buttons_nothing_arrived" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/controller_buttons_reason"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_controller_asleep"
                            android:tint="@color/controller_buttons_text_2" />

                        <TextView
                            style="@style/ControllerButtons.Text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingMultiplier="1.2"
                            android:text="@string/controller_buttons_reason_asleep"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/controller_buttons_reason"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_controller_lock"
                            android:tint="@color/controller_buttons_text_2" />

                        <TextView
                            style="@style/ControllerButtons.Text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingMultiplier="1.2"
                            android:text="@string/controller_buttons_reason_system"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/controller_buttons_back_to_buttons"
                            style="@style/ControllerButtons.Pill.Outlined"
                            android:text="@string/controller_buttons_back_to_buttons" />

                        <TextView
                            android:id="@+id/controller_buttons_try_again"
                            style="@style/ControllerButtons.Pill.Primary"
                            android:layout_marginStart="16dp"
                            android:text="@string/controller_buttons_try_again" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
